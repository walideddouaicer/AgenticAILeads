# Keep the image small and never bake local runtime data into it.
# The two tracked watchlists and configs/default.json seed only an empty volume.
.git
.gitignore
.venv
venv
__pycache__
*.pyc
.pytest_cache
.streamlit/secrets.toml
.env
.env.*
.engine.lock
data/
backups/
.claude/
AGENTS.local-before-pull.md

# Runtime data files (regenerated on the volume; not needed in the image)
signals.csv
enriched_signals.csv
signals_state.json
inbox_status.json
discovery_state.json
enriched_contacts.json
company_domains.json
prospects.csv
prospects_seen.json
prospect_signals.csv
prospect_signals_state.json
prospects_status.json
prospects_config.json
agency_watchlist.json
agency_discovery_state.json
prospector_probe.json
minilists/
job_history.json
mandate_history.json
board_refresh.json
agency_board_refresh.json
company_board_mappings.json
agency_board_mappings.json
agency_board_suggestions.json
contact_lookup_status.json
company_domains.json
client_meetings.json
prospect_key_aliases.json
prospect_identity_pending.json
run_status.json
today.json
icp.json
*.pending.json
*_probe.json
configs/*
!configs/default.json
!agency_watchlist.json

# Docs/build artifacts not needed at runtime
DEPLOY.pdf
