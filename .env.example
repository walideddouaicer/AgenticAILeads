# Copy this file to .env and fill in only the keys you have.
# Everything works WITHOUT any of these — the default channel is manual
# LinkedIn outreach (the app drafts, you send). Keys only light up
# optional integrations; no code change is needed to enable one.

# --- Apollo.io (enrichment_engine.py, prospector_engine.py, and the
#     Apollo email-sequences delivery adapter) ---
# Apollo -> Settings -> Integrations -> API -> create key (enable MASTER key).
APOLLO_API_KEY=

# --- Email-sending tools (delivery.py) ---
# Add a key to enable that adapter's "Export / Sync replies" features.
# Nothing is ever sent automatically — sending needs a key AND a button
# press. Verify payloads first with:  python delivery.py --probe

# Instantly.ai -> Settings -> Integrations -> API key (v2).
INSTANTLY_API_KEY=

# Smartlead.ai -> Settings -> API key.
SMARTLEAD_API_KEY=

# (Apollo email sequences reuse APOLLO_API_KEY above.)
